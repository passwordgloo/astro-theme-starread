{
  "name": "astro-theme-starread",
  "type": "module",
  "version": "1.11.5",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "scripts",
    "public",
    "CHANGELOG.md",
    "astro.config.mjs",
    "tsconfig.json",
    "starread.config.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    },
    "./components/*": {
      "import": "./src/components/*"
    },
    "./layouts": {
      "types": "./src/layouts/index.ts",
      "import": "./src/layouts/index.ts"
    },
    "./layouts/*": {
      "import": "./src/layouts/*"
    },
    "./widgets": {
      "types": "./src/widgets/index.ts",
      "import": "./src/widgets/index.ts"
    },
    "./widgets/*": {
      "import": "./src/widgets/*"
    },
    "./pages/*": {
      "import": "./src/pages/*"
    },
    "./styles": {
      "import": "./src/styles/global.css"
    },
    "./styles/*": {
      "import": "./src/styles/*"
    },
    "./scripts": {
      "import": "./scripts/index.js"
    },
    "./scripts/*": {
      "import": "./scripts/*"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./config": {
      "types": "./starread.config.ts",
      "import": "./starread.config.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./package.json": "./package.json"
  },
  "description": "既有星光般的璀璨，又不失简洁和高端感的Astro主题",
  "keywords": [
    "astro",
    "astro-theme",
    "blog-theme",
    "astro-blog"
  ],
  "author": "passwordgloo",
  "license": "CC-BY-SA-4.0",
  "homepage": "https://github.com/passwordgloo/astro-theme-starread#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/passwordgloo/astro-theme-starread.git"
  },
  "bugs": {
    "url": "https://github.com/passwordgloo/astro-theme-starread/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "astro build",
    "algolia": "node scripts/PushAlgolia.js"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/node": "^11.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.7.0",
    "astro": "^7.0.3",
    "sharp": "^0.34.3",
    "astro-theme-starread": "^1.11.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "algoliasearch": "^5.50.0",
    "tailwindcss": "^4.2.2"
  },
  "bin": {
    "create-astro-theme-starread": "scripts/init.cjs",
    "astro-theme-starread": "scripts/init.cjs"
  }
}