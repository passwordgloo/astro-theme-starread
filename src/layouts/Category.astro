---
import Base from '@theme/layouts/Base.astro';
import AuthorWidget from '@theme/widgets/AuthorWidget.astro';
import AdWidget from '@theme/widgets/AdWidget.astro';
import TagCloud from '@theme/widgets/TagCloud.astro';
import { themeConfig } from '@theme/config';

interface Props {
  title: string;
  categoryName?: string;
  currentCategory?: string;
  articles: any[];
  allCategories: Record<string, number>;
}

const { title, categoryName, currentCategory, articles, allCategories } = Astro.props;
const sidebarConfig = themeConfig.sidebar.home;

const tagCounts: Record<string, number> = {};
articles.forEach(item => {
  item.data.tags?.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
---

<Base title={title}>
  <!-- 左侧内容区域 -->
  <div class="space-y-6">
    <div class="bg-white/70 backdrop-blur-xl border border-white/20 shadow-[0_1px_0_0_rgba(255,255,255,0.6)_inset,0_8px_30px_rgba(0,0,0,0.06)] dark:bg-cyan-950/30 dark:backdrop-blur-xl dark:border-white/10 dark:shadow-[0_1px_0_0_rgba(255,255,255,0.08)_inset,0_8px_30px_rgba(0,0,0,0.35)] rounded-lg shadow-sm p-6">
      <h1 class="text-2xl font-bold mb-6">{categoryName || "所有分类"}</h1>

      <!-- 分类筛选标签 -->
      {allCategories && (
        <div class="flex flex-wrap gap-3 mb-8">
          {Object.entries(allCategories).map(([category, count]) => (
            <a 
              key={category} 
              href={`/category/${encodeURIComponent(category)}`} 
              class={`px-3 py-1 rounded-full text-sm transition-colors hover:opacity-90 ${ 
                category === currentCategory 
                  ? 'bg-primary dark:bg-secondary text-white' 
                  : 'bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200' 
              }`}
            >
              {category} ({count})
            </a>
          ))}
        </div>
      )}

      <!-- 文章列表 -->
      {articles.length > 0 ? (
        <div class="space-y-4">
          <div class="space-y-1">
            {articles.map((article) => (
              <div key={article.slug} class="flex justify-between items-center p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
                <h3 class="font-medium text-base"><a href={article.data.permalink} class="hover:text-primary dark:hover:text-secondary transition-colors">{article.data.title}</a></h3>
                <span class="text-sm text-gray-500 dark:text-gray-400">{typeof article.data.date === 'string' ? article.data.date.split(' ')[0] : article.data.date?.toISOString().split('T')[0]}</span>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="text-center py-8 text-gray-500">
          暂无该分类下的内容
        </div>
      )}
    </div>
  </div>

  <!-- 右侧边栏 -->
  <Fragment slot="sidebar">
    {sidebarConfig.authorWidget && <AuthorWidget />}
    {sidebarConfig.adWidget && <AdWidget />}
    {sidebarConfig.tag && <TagCloud tagCounts={tagCounts} />}
  </Fragment>
</Base>