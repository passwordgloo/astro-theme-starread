---
import Base from '@theme/layouts/Base.astro';
import AuthorWidget from '@theme/widgets/AuthorWidget.astro';
import AdWidget from '@theme/widgets/AdWidget.astro';
import TagCloud from '@theme/widgets/TagCloud.astro';
import { themeConfig } from '@theme/config';

interface Props {
  title: string;
  categoryName?: string;
  currentCategory?: string;
  articles: any[];
  allCategories: Record<string, number>;
}

const { title, categoryName, currentCategory, articles, allCategories } = Astro.props;
const sidebarConfig = themeConfig.sidebar.home;

const tagCounts: Record<string, number> = {};
articles.forEach(item => {
  item.data.tags?.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
---

<Base title={title} navbarTransparent={false}>
  <!-- 左侧内容区域 -->
  <div class="space-y-6">
    <div class="bg-white/70 backdrop-blur-xl border border-white/20 shadow-[0_1px_0_0_rgba(255,255,255,0.6)_inset,0_8px_30px_rgba(0,0,0,0.06)] dark:bg-cyan-950/30 dark:backdrop-blur-xl dark:border-white/10 dark:shadow-[0_1px_0_0_rgba(255,255,255,0.08)_inset,0_8px_30px_rgba(0,0,0,0.35)] rounded-lg shadow-sm p-6">
      <div class="flex items-center mb-6">
        <span class="inline-block w-6 h-6 mr-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg></span>
        <h1 class="text-2xl font-bold">{categoryName || "所有分类"}</h1>
      </div>

      <!-- 分类筛选标签 -->
      {allCategories && (
        <div class="flex flex-wrap gap-3 mb-8">
          {Object.entries(allCategories).map(([category, count]) => (
            <a
              key={category}
              href={`/category/${encodeURIComponent(category)}`}
              class={`px-3 py-1 rounded-full text-sm font-medium transition-colors ${
                category === currentCategory
                  ? 'bg-primary text-white dark:bg-secondary'
                  : 'bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-white/10 dark:text-gray-300 dark:hover:bg-white/20'
              }`}
            >
              {category} <span class="ml-1 opacity-80">({count})</span>
            </a>
          ))}
        </div>
      )}

      <!-- 文章列表 -->
      {articles.length > 0 ? (
        <div class="space-y-4">
          <div class="space-y-1">
            {articles.map((article) => (
              <div key={article.slug} class="flex justify-between items-center p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
                <h3 class="font-medium text-base"><a href={`/${article.id}`} class="hover:text-primary dark:hover:text-secondary transition-colors">{article.data.title}</a></h3>
                <span class="text-sm text-gray-500 dark:text-gray-400">{typeof article.data.date === 'string' ? article.data.date.split(' ')[0] : article.data.date?.toISOString().split('T')[0]}</span>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p class="text-center text-gray-500 dark:text-gray-400 py-10">暂无该分类下的内容</p>
      )}
    </div>
  </div>

  <!-- 右侧边栏 -->
  <Fragment slot="sidebar">
    {sidebarConfig.authorWidget && <AuthorWidget />}
    {sidebarConfig.adWidget && <AdWidget />}
    {sidebarConfig.tag && <TagCloud tagCounts={tagCounts} />}
  </Fragment>
</Base>