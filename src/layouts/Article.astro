---
import Base from '@theme/layouts/Base.astro';
import ArticleInfo from '@theme/components/ArticleInfo.astro';
import AuthorWidget from '@theme/widgets/AuthorWidget.astro';
import TagCloud from '@theme/widgets/TagCloud.astro';
import ArticleTOC from '@theme/components/ArticleTOC.astro';
import Comment from '@theme/components/Comment.astro';
import { themeConfig } from '@theme/config';

const { entry, wordCount, formatDate } = Astro.props;
const sidebarConfig = themeConfig.sidebar.article;

const tagCounts: Record<string, number> = {};
entry?.data?.tags?.forEach(tag => {
  tagCounts[tag] = (tagCounts[tag] || 0) + 1;
});
---

<Base title={Astro.props.title} navbarTransparent={true}>
  <Fragment slot="head">
    <!--  canonical链接，优先使用永久链接，否则使用slug -->
    <link rel="canonical" href={entry?.data?.permalink || (Astro.url.pathname)} />
  </Fragment>
  
  <Fragment slot="header">
    <ArticleInfo 
      title={entry?.data?.title || Astro.props.title}
      cover={entry?.data?.cover || Astro.props.cover || themeConfig.defaultCover}
      date={formatDate?.(entry?.data?.date) || Astro.props.date}
      tags={entry?.data?.tags || Astro.props.tags || []}
      categories={entry?.data?.categories || Astro.props.categories || []}
      wordCount={wordCount || Astro.props.wordCount || 0}
      permalink={entry?.data?.permalink || Astro.props.permalink}
    />
  </Fragment>
  
  <!-- 左侧内容 -->
  <slot />
  <Comment/>
  
  <!-- 右侧边栏 -->
  <Fragment slot="sidebar">
    {sidebarConfig.authorWidget && <AuthorWidget />}
    {sidebarConfig.tag && <TagCloud tagCounts={tagCounts} />}
    {sidebarConfig.toc && <ArticleTOC />}
  </Fragment>
</Base>
