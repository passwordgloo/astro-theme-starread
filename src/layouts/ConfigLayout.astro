---
import "../styles/global.css";
import { themeConfig } from '../../starread.config';
import NavBar from "../components/NavBar.astro";
import { getLangFromUrl, useTranslations } from '../utils';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const currentLang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(currentLang);
---

<html lang="zh-CN" class="min-h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={themeConfig.site.favicon} />
    <meta name="generator" content={Astro.generator} />
    <title>{ title || t.site.title }</title>
    <slot name="head"></slot>
  </head>
  <body class="min-h-screen bg-slate-100 text-gray-900 dark:bg-gray-950 dark:text-neutral-100 transition-colors">

    <NavBar title="主题配置" />
    
    <!-- 配置页面专用布局：参照Base.astro居中布局 -->
    <div class="config-page-container">
      <div class="config-layout-wrapper">
        <slot></slot>
      </div>
    </div>
  </body>
</html>

<style>
  /* 参照Base.astro的居中布局 */
  .config-page-container {
    width: 100%;
    padding: 1.5rem 1rem; /* py-6 px-4 */
    margin-top: 0;
  }

  /* 容器居中，与Base.astro的container mx-auto保持一致 */
  .config-layout-wrapper {
    width: 100%;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    min-height: calc(100vh - 64px - 3rem); /* 减去导航栏和padding */
  }

  @media (min-width: 640px) {
    .config-page-container {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .config-page-container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  @media (min-width: 1280px) {
    .config-page-container {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
  }
</style>
