---
import type { CollectionEntry } from 'astro:content';
import { themeConfig } from '../../starread.config';
import { FileText } from "@lucide/astro";
const categories = themeConfig.widget.categories;

interface Props {
  title: string;
  articles: CollectionEntry<'docs'>[];
  category: string;
  lang?: string;
}

const { title, articles, category, lang = 'zh' } = Astro.props;

const supportedLangs = ['zh', 'en', 'ja', 'ko', 'ru'];

const defaultLangArticles = articles.filter(article => {
  const firstSegment = article.id.split('/')[0];
  return !supportedLangs.includes(firstSegment);
});

const getArticleHref = (article: CollectionEntry<'docs'>) => {
  return `/${article.id}`;
};
---

<div class="bg-white/70 backdrop-blur-xl border border-white/20 shadow-[0_1px_0_0_rgba(255,255,255,0.6)_inset,0_8px_30px_rgba(0,0,0,0.06)] dark:bg-cyan-950/30 dark:backdrop-blur-xl dark:border-white/10 dark:shadow-[0_1px_0_0_rgba(255,255,255,0.08)_inset,0_8px_30px_rgba(0,0,0,0.35)] rounded-lg shadow-sm overflow-hidden">
  <div class="px-4 py-3 border-b border-gray-200 dark:border-white/10 flex justify-between items-center">
    <div class="flex items-center space-x-2">
      <FileText class="w-5 h-5" />
      <h2 class="font-bold text-lg text-dark">{title}</h2>
    </div>
    <a href={`/category/${encodeURIComponent(category)}`} class="text-sm hover:text-primary dark:hover:text-secondary transition-colors" data-astro-prefetch>更多</a>
  </div>
  
  <div class="p-4 space-y-4">
    {defaultLangArticles.length > 0 ? (
      defaultLangArticles.slice(0, 5).map((article) => (
        <article key={article.id} class="flex items-center space-x-3">
          {article.data.cover && (
            <img src={article.data.cover} alt={article.data.title} class="w-16 h-16 object-cover rounded-lg" />
          )}
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-sm truncate">
              <a href={getArticleHref(article)} class="hover:text-primary dark:hover:text-secondary transition-colors">
                {article.data.title}
              </a>
            </h3>
            <p class="text-xs text-gray-500 truncate mt-1">
              {article.data.description}
            </p>
            <div class="flex items-center space-x-2 mt-1">
              <span class="text-xs text-gray-400">
                {article.data.date ? new Date(article.data.date).toLocaleDateString() : ''}
              </span>
              {article.data.tags && article.data.tags.length > 0 && (
                <span class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded">
                  {article.data.tags[0]}
                </span>
              )}
            </div>
          </div>
        </article>
      ))
    ) : (
      <p class="text-gray-500 text-sm text-center py-4">暂无内容</p>
    )}
  </div>
</div>
