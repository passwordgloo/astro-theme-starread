---
import type { CollectionEntry } from 'astro:content';
import { themeConfig } from '@theme/config';
import { sortEntriesByDate, processEntryData } from '@theme/components/Frontmatter';
import PostCard from '@theme/components/PostCard.astro';
import { Newspaper } from "@lucide/astro";

interface Props {
  articles?: CollectionEntry<'docs'>[];
  lang?: string;
}

const { articles = [], lang = 'zh' } = Astro.props;
const latestArticleConfig = themeConfig.widget.LatestArticle;
const { type: loadType, layout = 'vertical', initialLoad, loadMore, defaultLimit, columns = 2 } = latestArticleConfig;

const supportedLangs = ['zh', 'en', 'ja', 'ko', 'ru'];
const defaultLangArticles = articles.filter(article => {
  const firstSegment = article.id.split('/')[0];
  return !supportedLangs.includes(firstSegment);
});

const processedArticles = processEntryData(defaultLangArticles, 'docs');
const sortedArticles = sortEntriesByDate(processedArticles).slice(0, defaultLimit);

const articlesForClient = sortedArticles.map(article => ({
  title: article.data.title,
  id: article.id,
  collection: 'docs',
  cover: article.processed?.cover || '/defaultCover.jpg',
  date: article.processed?.date || '',
  categories: article.processed?.categories || [],
  author: article.processed?.author?.name || '未知作者'
}));
---

<div class="relative">
  <div class="bg-white/70 backdrop-blur-xl border border-white/20 shadow-[0_1px_0_0_rgba(255,255,255,0.6)_inset,0_8px_30px_rgba(0,0,0,0.06)] dark:bg-cyan-950/30 dark:backdrop-blur-xl dark:border-white/10 dark:shadow-[0_1px_0_0_rgba(255,255,255,0.08)_inset,0_8px_30px_rgba(0,0,0,0.35)] rounded-lg shadow-sm p-4 mb-6">
    <div class="flex items-center space-x-2 mb-4">
      <Newspaper class="w-5 h-5" />
      <h2 class="font-bold text-lg text-dark">最新文章</h2>
    </div>
    
    <div class={`grid gap-4 ${columns > 1 ? `grid-cols-${columns}` : 'grid-cols-1'}`}>
      {sortedArticles.map((article) => (
        <div key={article.id}>
          <PostCard article={article} layout={layout} />
        </div>
      ))}
    </div>
  </div>
</div>
