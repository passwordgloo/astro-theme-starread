---
import { themeConfig } from '../../starread.config';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { ChartBar, FileText, Folder, Tag, CalendarDays, Eye, Users } from "@lucide/astro";

interface Props {
  articleCount: number;
  categoryCount: number;
  tagCount: number;
}

const { articleCount, categoryCount, tagCount } = Astro.props;

const currentLang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(currentLang);

function getSiteDays() {
  if (!themeConfig.site.foundedDate) return 0;
  
  const founded = new Date(themeConfig.site.foundedDate);
  const today = new Date();
  const diffTime = Math.abs(today.getTime() - founded.getTime());
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  return diffDays;
}

const siteDays = getSiteDays();
---

<div class="bg-white/70 backdrop-blur-xl border border-white/20 shadow-[0_1px_0_0_rgba(255,255,255,0.6)_inset,0_8px_30px_rgba(0,0,0,0.06)] dark:bg-cyan-950/30 dark:backdrop-blur-xl dark:border-white/10 dark:shadow-[0_1px_0_0_rgba(255,255,255,0.08)_inset,0_8px_30px_rgba(0,0,0,0.35)] rounded-lg shadow-sm p-4">
  <div class="flex items-center space-x-2 mb-4">
    <ChartBar class="w-5 h-5 text-accent" />
    <span class="text-accent font-bold text-lg">{t.sidebar.statistic}</span>
  </div>

  <div class="space-y-3 text-sm">
    <!-- 文章总数 -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <FileText class="w-4 h-4 text-gray-500 dark:text-slate-400" />
        <span class="text-gray-600 dark:text-slate-400">{currentLang === 'zh' ? '文章总数' : currentLang === 'en' ? 'Articles' : currentLang === 'ja' ? '記事数' : currentLang === 'ko' ? '기사 수' : 'Статей'}</span>
      </div>
      <span class="font-medium text-primary dark:text-secondary">{articleCount} {currentLang === 'zh' ? '篇' : currentLang === 'ja' ? '編' : ''}</span>
    </div>

    <!-- 分类数量 -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <Folder class="w-4 h-4 text-gray-500 dark:text-slate-400" />
        <span class="text-gray-600 dark:text-slate-400">{currentLang === 'zh' ? '分类数量' : currentLang === 'en' ? 'Categories' : currentLang === 'ja' ? 'カテゴリ数' : currentLang === 'ko' ? '카테고리 수' : 'Категорий'}</span>
      </div>
      <span class="font-medium text-primary dark:text-secondary">{categoryCount} {currentLang === 'zh' ? '个' : currentLang === 'ja' ? '個' : ''}</span>
    </div>

    <!-- 标签数量 -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <Tag class="w-4 h-4 text-gray-500 dark:text-slate-400" />
        <span class="text-gray-600 dark:text-slate-400">{currentLang === 'zh' ? '标签数量' : currentLang === 'en' ? 'Tags' : currentLang === 'ja' ? 'タグ数' : currentLang === 'ko' ? '태그 수' : 'Тегов'}</span>
      </div>
      <span class="font-medium text-primary dark:text-secondary">{tagCount} {currentLang === 'zh' ? '个' : currentLang === 'ja' ? '個' : ''}</span>
    </div>

    <!-- 建站天数 -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <CalendarDays class="w-4 h-4 text-gray-500 dark:text-slate-400" />
        <span class="text-gray-600 dark:text-slate-400">{currentLang === 'zh' ? '建站天数' : currentLang === 'en' ? 'Days Online' : currentLang === 'ja' ? '運営日数' : currentLang === 'ko' ? '운영 일수' : 'Дней онлайн'}</span>
      </div>
      <span class="font-medium text-primary dark:text-secondary">{siteDays} {currentLang === 'zh' ? '天' : currentLang === 'ja' ? '日' : 'days'}</span>
    </div>

    <!-- 总访问量 -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <Eye class="w-4 h-4 text-gray-500 dark:text-slate-400" />
        <span class="text-gray-600 dark:text-slate-400">{currentLang === 'zh' ? '总访问量' : currentLang === 'en' ? 'Total Views' : currentLang === 'ja' ? '総アクセス数' : currentLang === 'ko' ? '총 방문 수' : 'Всего просмотров'}</span>
      </div>
      <span id="busuanzi_site_pv" class="font-medium text-primary dark:text-secondary">{currentLang === 'zh' ? '加载中...' : 'Loading...'}</span>
    </div>

    <!-- 总访客数 -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <Users class="w-4 h-4 text-gray-500 dark:text-slate-400" />
        <span class="text-gray-600 dark:text-slate-400">{currentLang === 'zh' ? '总访客数' : currentLang === 'en' ? 'Total Visitors' : currentLang === 'ja' ? '総訪問者数' : currentLang === 'ko' ? '총 방문자 수' : 'Всего посетителей'}</span>
      </div>
      <span id="busuanzi_site_uv" class="font-medium text-primary dark:text-secondary">{currentLang === 'zh' ? '加载中...' : 'Loading...'}</span>
    </div>
  </div>
</div>

<script>
  // 确保不蒜子脚本已加载
  function loadBusuanzi() {
    if (typeof window !== 'undefined' && !window.busuanzi) {
      const script = document.createElement('script');
      script.src = '/busuanzi.min.js';
      script.async = true;
      document.head.appendChild(script);
    }
  }

  // 页面加载完成后执行
  if (typeof window !== 'undefined') {
    loadBusuanzi();
  }
</script>