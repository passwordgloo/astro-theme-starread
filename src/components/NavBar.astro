---
const { title, transparent = true } = Astro.props;
import { themeConfig } from '@theme/config';
import { getLangFromUrl, switchLangPath, useTranslations, getAvailableLanguages, flattenNavbarToNested } from '@theme/utils';
import Search from '@theme/components/Search.astro';
import { 
  ChevronDown, Menu, X, Home, Database, Book, Code, Server, HelpCircle, Lock, Languages,
  Sun, Moon
} from "@lucide/astro";

const currentUrl = Astro.url.pathname;
const currentLang = getLangFromUrl(currentUrl);
const t = useTranslations(currentLang);



const iconMap: Record<string, any> = {
  Home,
  Database,
  Book,
  Code,
  Server,
  HelpCircle,
  Lock,
  Languages,
};

function getIcon(iconName: string | undefined) {
  if (!iconName) return null;
  return iconMap[iconName] || null;
}

const languages = getAvailableLanguages();
---

<!-- transparent=false 时（文章/分类/标签等无 hero 页面）始终使用首页滚动后的
     导航栏背景色，避免纯透明背景；无边框，仅滚动后加阴影 -->
<header id="navbar" class={`${transparent ? 'bg-transparent backdrop-blur-0' : 'bg-white/85 backdrop-blur-xl dark:bg-slate-900/85'} shadow-none sticky top-0 z-50 transition-all duration-300 navbar-scrolled:bg-white/85 navbar-scrolled:backdrop-blur-xl navbar-scrolled:shadow-md dark:navbar-scrolled:bg-slate-900/85`} client:load>
  <div class="container mx-auto px-4 py-3 flex items-center justify-between">
    <div class="flex items-center space-x-2 nav-content">
      <div id="logo-container">
        <a href="/" class="block">
          {themeConfig.logo.image ? (
            <img 
              src={themeConfig.logo.image} 
              alt={themeConfig.logo.alt} 
              class="h-8 w-auto logo-image" 
              data-light-src={themeConfig.logo.image} 
              data-dark-src={themeConfig.logo.darkImage} 
            /> 
          ) : (
            <span class="font-bold text-xl nav-logo-text">{themeConfig.logo.text}</span>
          )}
        </a>
      </div>
    </div>
    <div class="article-title hidden group-[.show-title]:block text-lg font-medium overflow-hidden whitespace-nowrap text-ellipsis w-full md:w-auto text-center md:text-left">
      { title || t.site.title }
    </div>

    <nav class="hidden md:flex items-center space-x-6 group-[.show-title]:hidden">
      {flattenNavbarToNested(t.navbar).map((item, index) => {
        const ItemIcon = getIcon(item.icon);
        return (
          <div class="relative group" key={`nav-${index}-${item.name || item.text}`}>
            {item.href ? (
              <a href={item.href} class="nav-link transition-colors flex items-center space-x-2.5 p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md" data-astro-prefetch="viewport">
                {ItemIcon && <ItemIcon class="w-5 h-5 flex-shrink-0" />}
                <span>{item.text || item.name}</span>
              </a>
            ) : (
              <button class="nav-link transition-colors flex items-center space-x-2.5 p-2 group-hover:bg-gray-100 dark:group-hover:bg-gray-800 rounded-md">
                {ItemIcon && <ItemIcon class="w-5 h-5 flex-shrink-0" />}
                <span>{item.name || item.text}</span>
                <ChevronDown class="w-5 h-5 ml-1" />
              </button>
            )}

            {item.items && item.items.length > 0 && (
              <div class="absolute right-0 mt-2 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 shadow-lg rounded-lg z-10 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 origin-top-right whitespace-nowrap">
                {item.items.map((subItem, subIndex) => {
                  const SubItemIcon = getIcon(subItem.icon);
                  return (
                    <a
                      href={subItem.link || subItem.href || '#'}
                      class="block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex items-center whitespace-nowrap"
                      key={`nav-${index}-${subIndex}`}
                      data-astro-prefetch="viewport"
                    >
                      {SubItemIcon && <SubItemIcon class="w-5 h-5 mr-2 flex-shrink-0" />}
                      {subItem.text || subItem.name}
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
    </nav>
    <div class="flex items-center space-x-4">
      <div class="relative group" id="lang-switcher">
        <button class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex items-center space-x-1" aria-label="切换语言">
          <Languages class="w-5 h-5" />
          <ChevronDown class="w-4 h-4" />
        </button>
        <div class="absolute right-0 mt-2 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 shadow-lg rounded-lg z-10 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 origin-top-right whitespace-nowrap">
          {languages.map(lang => {
            const targetUrl = switchLangPath(currentUrl, lang.code);
            const isActive = lang.code === currentLang;
            return (
              <a
                key={lang.code}
                href={targetUrl}
                class={`flex items-center space-x-2 px-4 py-2 transition-colors ${isActive ? 'bg-primary/10 text-primary' : 'hover:bg-gray-100 dark:hover:bg-gray-800'} whitespace-nowrap`}
              >
                <span class="text-xs font-semibold w-8 text-center">{lang.code.toUpperCase()}</span>
                <span class="text-sm">{lang.name}</span>
                {isActive && <span class="ml-auto text-xs">✓</span>}
              </a>
            );
          })}
        </div>
      </div>
      <Search />
      <button id="theme-toggle" class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="切换主题">
        <Sun class="w-5 h-5 theme-icon-sun" />
        <Moon class="w-5 h-5 theme-icon-moon hidden" />
      </button>
      <a href={themeConfig.loginUrl || '/config'} class="hidden md:block rounded-lg bg-primary text-white hover:bg-primary-dark active:bg-primary-dark
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 px-4 py-2 rounded-md transition-colors">配置</a>
      <button id="mobile-menu-toggle" class="md:hidden p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
        <Menu class="h-5 w-5 nav-menu-icon" />
      </button>
    </div>
  </div>
</header>

<div id="mobile-sidebar" class="fixed inset-0 z-50 hidden md:hidden">
  <div class="fixed inset-0 bg-black/10 backdrop-blur-sm" id="mobile-sidebar-overlay"></div>
  <div class="fixed right-0 top-0 h-full w-64 bg-white dark:bg-gray-900 border-l border-gray-200 dark:border-gray-700 shadow-xl transform translate-x-full transition-transform duration-300 ease-in-out" id="mobile-sidebar-content">
    <div class="p-4 border-b border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between">
        <h3 class="font-semibold text-lg">菜单</h3>
        <button id="mobile-sidebar-close" class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800">
          <X class="h-5 w-5" />
        </button>
      </div>
    </div>
    <nav class="p-4 space-y-2">
      <div class="p-3">
        <Search />
      </div>
      {flattenNavbarToNested(t.navbar).map((item, index) => {
        const MobileIcon = getIcon(item.icon);
        return (
          <div key={`mobile-nav-${index}`}>
            {item.href ? (
              <a href={item.href} class="flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" data-astro-prefetch>
                {MobileIcon && <MobileIcon class="h-5 w-5" />}
                <span>{item.name || item.text}</span>
              </a>
            ) : (
              <div class="p-3">
                <div class="flex items-center space-x-3 mb-2">
                  {MobileIcon && <MobileIcon class="h-5 w-5" />}
                  <span class="font-medium">{item.name || item.text}</span>
                </div>
                {item.items && item.items.map((subItem, subIndex) => {
                  return (
                    <a 
                      key={`mobile-nav-${index}-${subIndex}`} 
                      href={subItem.link || subItem.href || '#'} 
                      class="block py-1 text-sm text-gray-500 dark:text-gray-400 hover:text-primary" 
                      data-astro-prefetch
                    >
                      {subItem.text || subItem.name}
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
    </nav>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.getElementById('navbar');

    const updateLogo = () => {
      const htmlElement = document.documentElement;
      const logoImages = document.querySelectorAll('.logo-image');
      const isDarkMode = htmlElement.classList.contains('dark');
      
      logoImages.forEach(logoImage => {
        if (logoImage && logoImage.dataset.darkSrc && logoImage.dataset.lightSrc) {
          const newSrc = isDarkMode ? logoImage.dataset.darkSrc : logoImage.dataset.lightSrc;
          if (logoImage.src !== newSrc) {
            logoImage.src = newSrc;
          }
        }
      });
    };

    const htmlElement = document.documentElement;
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class') {
          updateLogo();
        }
      });
    });

    observer.observe(htmlElement, { 
      attributes: true, 
      attributeFilter: ['class'] 
    });

    updateLogo();

    let lastScrollY = window.scrollY;
    let ticking = false;

    function handleScroll() {
      if (!navbar) return;

      const currentScrollY = window.scrollY;
      
      if (currentScrollY > 0) {
        navbar.classList.add('navbar-scrolled');
      } else {
        navbar.classList.remove('navbar-scrolled');
      }

      if (currentScrollY > lastScrollY && currentScrollY > 100) {
        navbar.classList.add('show-title');
        navbar.classList.remove('hide-nav');
      } 
      else if (currentScrollY < lastScrollY) {
        navbar.classList.remove('show-title');
        navbar.classList.remove('hide-nav');
      }
      
      if (currentScrollY <= 10) {
        navbar.classList.remove('show-title');
        navbar.classList.remove('hide-nav');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(handleScroll);
        ticking = true;
      }
    });

    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileSidebar = document.getElementById('mobile-sidebar');

    if (mobileMenuToggle && mobileSidebar) {
      const mobileSidebarOverlay = mobileSidebar.querySelector('#mobile-sidebar-overlay');
      const mobileSidebarClose = mobileSidebar.querySelector('#mobile-sidebar-close');
      const mobileSidebarContent = mobileSidebar.querySelector('#mobile-sidebar-content');

      mobileMenuToggle.addEventListener('click', () => {
        mobileSidebar.classList.remove('hidden');
        setTimeout(() => {
          mobileSidebarOverlay.classList.add('opacity-100');
          mobileSidebarContent.classList.remove('translate-x-full');
        }, 10);
        document.body.classList.add('overflow-hidden');
      });

      const closeSidebar = () => {
        mobileSidebarContent.classList.add('translate-x-full');
        mobileSidebarOverlay.classList.remove('opacity-100');
        setTimeout(() => {
          mobileSidebar.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }, 300);
      };

      mobileSidebarClose.addEventListener('click', closeSidebar);
      mobileSidebarOverlay.addEventListener('click', closeSidebar);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileSidebar.classList.contains('hidden')) {
          closeSidebar();
        }
      });

      const sidebarLinks = mobileSidebar.querySelectorAll('a');
      sidebarLinks.forEach(link => {
        link.addEventListener('click', closeSidebar);
      });
    }

    const themeToggle = document.getElementById('theme-toggle');
    const sunIcon = document.querySelector('.theme-icon-sun');
    const moonIcon = document.querySelector('.theme-icon-moon');

    function getCurrentMode() {
      return localStorage.getItem('theme-mode') || 'light';
    }

    function setThemeMode(mode) {
      localStorage.setItem('theme-mode', mode);
      updateThemeUI(mode);
      applyTheme(mode);
    }

    function updateThemeUI(mode) {
      sunIcon.classList.add('hidden');
      moonIcon.classList.add('hidden');

      if (mode === 'light') {
        sunIcon.classList.remove('hidden');
      } else {
        moonIcon.classList.remove('hidden');
      }
    }

    function applyTheme(mode) {
      const htmlEl = document.documentElement;

      if (mode === 'light') {
        htmlEl.classList.remove('dark');
      } else {
        htmlEl.classList.add('dark');
      }
    }

    function toggleTheme() {
      const currentMode = getCurrentMode();
      const nextMode = currentMode === 'light' ? 'dark' : 'light';
      setThemeMode(nextMode);
    }

    themeToggle.addEventListener('click', toggleTheme);

    const savedMode = getCurrentMode();
    updateThemeUI(savedMode);
    applyTheme(savedMode);
  });
</script>
