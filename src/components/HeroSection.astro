---
import { themeConfig } from '@theme/config';

const heroConfig = themeConfig.hero;
const heroEnabled = heroConfig?.enabled !== false;
const bgImage = heroConfig?.backgroundImage || '/cover/2f0bcf8fe63c00af.avif';
const titleConfig = heroConfig?.title;
const effectConfig = heroConfig?.effect;
const navbarTransparent = heroConfig?.navbarTransparent !== false;

const isJinrishiciMode = titleConfig?.mode === 'jinrishici';
const customContent = titleConfig?.content || 'Starread';

const gradientEnabled = effectConfig?.gradient?.enabled !== false;
const gradientColors = effectConfig?.gradient?.colors || ['#2563eb', '#9333ea', '#ec4899'];

const typingEnabled = effectConfig?.typing?.enabled !== false;
const typingRepeat = effectConfig?.typing?.repeat === true;
const cursorEnabled = effectConfig?.typing?.cursor !== false;
const cursorStyle = effectConfig?.typing?.cursorStyle || 'line';

const titleStyle = gradientEnabled 
  ? `background: linear-gradient(90deg, ${gradientColors.join(', ')}); background-size: 200% 200%; -webkit-text-fill-color: transparent; -webkit-background-clip: text; background-clip: text; animation: gradient-flow 4s ease infinite;`
  : '';

// Hero 区域显示时设置导航栏透明
if (heroEnabled && navbarTransparent) {
  // 设置一个全局标志，告诉导航栏需要透明
  globalThis.heroNavbarTransparent = true;
}
---

{heroEnabled && (
<div class="relative w-full h-screen overflow-hidden -mt-16">
  <div class="absolute inset-0">
    <img 
      src={bgImage} 
      alt="首页壁纸" 
      class="w-full h-full object-cover"
      onerror="this.src='/img/2256c4860b3d6be29e7044728d371b33.png'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-100 dark:from-gray-950 via-gray-50/60 dark:via-gray-900/60 to-transparent"></div>
  </div>
  
  <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
    <h1 
      id="hero-title" 
      class="text-4xl md:text-6xl lg:text-7xl font-bold text-gray-900 dark:text-white"
      data-mode={isJinrishiciMode ? 'jinrishici' : 'text'}
      data-content={customContent}
      data-animate={typingEnabled ? 'true' : 'false'}
      data-repeat={typingRepeat ? 'true' : 'false'}
      data-cursor={cursorEnabled ? 'true' : 'false'}
      data-cursor-style={cursorStyle}
      data-gradient={gradientEnabled ? 'true' : 'false'}
      data-gradient-colors={gradientColors.join(',')}
      style={titleStyle}
    >
      {isJinrishiciMode ? <span class="animate-pulse">诗词加载中...</span> : (typingEnabled ? '' : customContent)}
      {cursorEnabled && !isJinrishiciMode && !typingEnabled && (
        <span id="hero-cursor" class={`inline-block ml-1 ${cursorStyle === 'block' ? 'w-[0.2em] h-[0.9em]' : 'w-[0.05em] h-[0.85em]'} bg-current`} style={{ animation: 'cursor-blink 1s step-end infinite' }}></span>
      )}
    </h1>
  </div>
  
  </div>
)}

<script client:idle>
  (() => {
    const titleEl = document.getElementById('hero-title');
    if (!titleEl) return;
    
    const mode = titleEl.dataset.mode;
    const content = titleEl.dataset.content;
    const animate = titleEl.dataset.animate === 'true';
    const repeat = titleEl.dataset.repeat === 'true';
    const cursor = titleEl.dataset.cursor === 'true';
    const cursorStyle = titleEl.dataset.cursorStyle;
    
    if (mode === 'jinrishici') {
      fetch('https://v2.jinrishici.com/one.json?client=browser-sdk/1.2')
        .then(res => res.json())
        .then(data => {
          if (data && data.data) {
            const poemContent = data.data.content;
            const displayText = poemContent.replace(/[「」""]/g, '');
            if (animate) {
              typeText(displayText);
            } else {
              titleEl.textContent = displayText;
              if (cursor) addCursor();
            }
          }
        })
        .catch(() => {
          const fallback = '行到水穷处，坐看云起时';
          if (animate) {
            typeText(fallback);
          } else {
            titleEl.textContent = fallback;
            if (cursor) addCursor();
          }
        });
    } else if (content) {
      if (animate) {
        typeText(content);
      } else {
        titleEl.textContent = content;
        if (cursor) addCursor();
      }
    }
    
    function typeText(text) {
      let index = 0;
      titleEl.textContent = '';
      
      const typeInterval = setInterval(() => {
        if (index < text.length) {
          titleEl.textContent += text[index];
          index++;
        } else {
          clearInterval(typeInterval);
          if (cursor) addCursor();
          if (repeat) {
            setTimeout(() => {
              typeText(text);
            }, 2000);
          }
        }
      }, 100);
    }
    
    function addCursor() {
      const cursorEl = document.createElement('span');
      cursorEl.id = 'hero-cursor';
      cursorEl.className = `inline-block ml-1 ${cursorStyle === 'block' ? 'w-[0.2em] h-[0.9em]' : 'w-[0.05em] h-[0.85em]'} bg-current`;
      cursorEl.style.animation = 'cursor-blink 1s step-end infinite';
      titleEl.appendChild(cursorEl);
    }
  })();
</script>

<style>
  @keyframes gradient-flow {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
  
  @keyframes cursor-blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
