---
import { Image } from 'astro:assets';
import { themeConfig } from '../../starread.config';
import { getLangFromUrl, useTranslations } from '../utils';
import { User } from "@lucide/astro";

const currentLang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(currentLang);
---

<div class="bg-white/70 backdrop-blur-xl border border-white/20 shadow-[0_1px_0_0_rgba(255,255,255,0.6)_inset,0_8px_30px_rgba(0,0,0,0.06)] dark:bg-cyan-950/30 dark:backdrop-blur-xl dark:border-white/10 dark:shadow-[0_1px_0_0_rgba(255,255,255,0.08)_inset,0_8px_30px_rgba(0,0,0,0.35)] rounded-lg shadow-sm p-4">
  <div class="flex items-center space-x-3 mb-4">
  <Image src={themeConfig.widget.author.avatar} alt={t.widget.author.name} class="w-10 h-10 rounded-full object-cover" width={40} height={40} />
  <div>
    <div class="flex items-center space-x-2">
      <User class="w-4 h-4" />
      <h3 class="font-medium">{t.widget.author.name}</h3>
    </div>
    <p class="text-sm text-primary dark:text-secondary">{t.widget.author.description}</p>
  </div>
</div>
<div class="space-y-2 text-sm text-gray-600 dark:text-slate-500">
  <p>Bilibili: {themeConfig.widget.author.social.bilibili}</p>
  <p>QQ: {themeConfig.widget.author.social.qq}</p>
</div>
</div>