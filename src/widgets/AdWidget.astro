---
import { themeConfig } from '@theme/config';
import { getLangFromUrl, useTranslations } from '@theme/utils';

const currentLang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(currentLang);
---

<div class="bg-gradient-to-r from-primary to-primary-light rounded-lg shadow-sm p-4 text-white">
  <h3 class="font-bold text-lg mb-2">{t.widget.ad.title}</h3>
<p class="mb-3 text-sm opacity-90">{t.widget.ad.description}</p>
<a href={themeConfig.widget.ad.link} class="bg-white text-primary rounded-md px-3 py-1 text-sm font-medium hover:bg-opacity-90 transition-colors inline-block">{t.widget.ad.buttonText}</a>
</div>