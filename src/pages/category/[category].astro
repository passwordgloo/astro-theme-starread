---
import { getCollection } from 'astro:content';
import CategoryLayout from '@theme/layouts/Category.astro';

export const prerender = true;

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  
  const allCategories = new Set<string>();
  docs.forEach(doc => {
    doc.data.categories?.forEach(category => allCategories.add(category));
  });
  
  return Array.from(allCategories).map(category => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
const docsWithCategory = await getCollection('docs', ({ data }) =>
  data.categories?.includes(category) ?? false
);

const allContent = [...docsWithCategory].sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const allDocs = await getCollection('docs');
const categoryCounts: Record<string, number> = {};
allDocs.forEach(doc => {
  doc.data.categories?.forEach(cat => {
    categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
  });
});

const pageTitle = `分类: ${category}`;
---

<CategoryLayout 
  title={pageTitle} 
  categoryName={category} 
  currentCategory={category} 
  articles={allContent} 
  allCategories={categoryCounts} 
/>
