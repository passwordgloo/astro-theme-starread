---
import { getCollection } from 'astro:content';
import CategoryLayout from '@theme/layouts/Category.astro';

const docs = await getCollection('docs');

const categoryCounts: Record<string, number> = {};
docs.forEach(doc => {
  doc.data.categories?.forEach(category => {
    categoryCounts[category] = (categoryCounts[category] || 0) + 1;
  });
});

const sortedCategories = Object.entries(categoryCounts).sort(([, a], [_, b]) => b - a);
const pageTitle = '所有分类';
---

<CategoryLayout
  title={pageTitle}
  categoryName="所有分类"
  articles={[]}
  allCategories={Object.fromEntries(sortedCategories)}
/>
