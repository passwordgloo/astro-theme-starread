    padding: 2px 8px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  :global(.dark) .widget-key {
    color: #9ca3af;
    background: rgba(255, 255, 255, 0.1);
  }

  /* 代码预览 - Shiki风格 */
