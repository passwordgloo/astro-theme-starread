  /* 隐藏元素 */
  .hidden {
    display: none !important;
  }

  /* 响应式 - 平板及以下 */
  @media (max-width: 1024px) {
    .config-page-wrapper {
      flex-direction: column;
    }

    .config-sidebar {
      width: 100%;
      min-width: auto;
      position: relative;
      margin-right: 0;
      margin-bottom: 1.5rem;
      max-height: none;
