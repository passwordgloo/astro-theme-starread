---
import ConfigLayout from '@theme/layouts/ConfigLayout.astro';
import {
  Settings, Home, FileText, Palette, Target, Image, User, Megaphone,
  FolderOpen, Menu, LayoutGrid, Plus, Trash2, GripVertical, Download,
  RotateCcw, Copy, Check, X, ChevronRight, ChevronUp, ChevronDown, Upload, Languages
} from "@lucide/astro";
import { themeConfig } from '@theme/config';

const isDev = import.meta.env.DEV;
---

<ConfigLayout title="主题配置生成器">
  <!-- 顶部导航栏 -->

  
  <div class="config-page-wrapper">
    <!-- 左侧边栏 -->
    <aside class="config-sidebar">
      <div class="sidebar-header">
        <div class="logo-glass">
          <Settings class="w-6 h-6" />
        </div>
        <h1 class="sidebar-title">配置中心</h1>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-section">
          <span class="nav-label">基础配置</span>
          <a href="#hero" class="nav-item active" data-section="hero">
            <Image class="nav-icon" />
            <span>Hero 区域</span>
          </a>
          <a href="#site" class="nav-item" data-section="site">
            <Home class="nav-icon" />
            <span>网站信息</span>
          </a>
          <a href="#article" class="nav-item" data-section="article">
            <FileText class="nav-icon" />
            <span>文章设置</span>
          </a>
          <a href="#appearance" class="nav-item" data-section="appearance">
            <Palette class="nav-icon" />
            <span>外观效果</span>
          </a>
        </div>

        <div class="nav-section">
          <span class="nav-label">组件配置</span>
          <a href="#banner" class="nav-item" data-section="banner">
            <Target class="nav-icon" />
            <span>Banner</span>
          </a>
          <a href="#carousel" class="nav-item" data-section="carousel">
            <Image class="nav-icon" />
            <span>轮播图</span>
          </a>
          <a href="#author" class="nav-item" data-section="author">
            <User class="nav-icon" />
            <span>作者信息</span>
          </a>
          <a href="#ad" class="nav-item" data-section="ad">
            <Megaphone class="nav-icon" />
            <span>广告配置</span>
          </a>
        </div>

        <div class="nav-section">
          <span class="nav-label">结构配置</span>
          <a href="#categories" class="nav-item" data-section="categories">
            <FolderOpen class="nav-icon" />
            <span>文章分类</span>
          </a>
          <a href="#i18n" class="nav-item" data-section="i18n">
            <Languages class="nav-icon" />
            <span>多语言配置</span>
          </a>
          <a href="#navbar" class="nav-item" data-section="navbar">
            <Menu class="nav-icon" />
            <span>导航菜单</span>
          </a>
          <a href="#sidebar" class="nav-item" data-section="sidebar">
            <LayoutGrid class="nav-icon" />
            <span>侧边栏组件</span>
          </a>
        </div>
      </nav>

      <div class="sidebar-footer">
        <button class="btn-generate" id="btn-generate">
          <span>生成配置</span>
          <ChevronRight class="w-4 h-4" />
        </button>
      </div>
    </aside>

    <!-- 右侧内容区 -->
    <main class="config-main">
      <!-- 顶部标题栏 -->
      <header class="main-header">
        <div class="header-content">
          <h2 class="header-title">Starread 主题配置</h2>
          <p class="header-desc">通过可视化界面自定义您的博客主题</p>
        </div>
        <div class="header-actions">
          <button class="btn-secondary" id="btn-reset">
            <RotateCcw class="w-4 h-4 mr-1" />
            重置
          </button>
          <button class="btn-primary" id="btn-download">
            <Download class="w-4 h-4 mr-1" />
            下载配置
          </button>
        </div>
      </header>

      <!-- 表单内容 -->
      <div class="form-content">
        <!-- 网站信息 -->
        <!-- Hero 区域配置 -->
        <section id="hero" class="form-section active">
          <div class="section-header">
            <span class="section-badge">01</span>
            <div>
              <h3 class="section-title">Hero 区域</h3>
              <p class="section-subtitle">配置首页全屏壁纸展示区域</p>
            </div>
          </div>

          <div class="form-card">
            <div class="form-grid">
              <div class="form-field col-span-2">
                <label class="switch-card">
                  <input type="checkbox" name="hero.enabled" checked class="switch-input" />
                  <span class="switch-slider"></span>
                  <span class="switch-label">
                    <span class="switch-title">显示 Hero 区域</span>
                  </span>
                </label>
              </div>

              <div class="form-field col-span-2">
                <label class="field-label">背景图片</label>
                <div class="field-input-group">
                  <input type="text" name="hero.backgroundImage" value="/cover/NyYehQHfww_67cNm35rPO.jpg" class="field-input" placeholder="/cover/hero-bg.jpg" readonly />
                  <button class="input-action" type="button" data-upload="heroBg">
                    <Upload class="w-4 h-4" />
                  </button>
                  <button class="input-action input-action-danger" type="button" data-clear="heroBg" title="清除文件" style="display: none;">
                    <Trash2 class="w-4 h-4" />
                  </button>
                </div>
                <span class="field-hint">首页全屏背景图片，建议尺寸 1920x1080</span>
              </div>
            </div>
          </div>

          <div class="form-card">
            <h4 class="card-subtitle">文字内容</h4>
            <div class="form-grid">
              <div class="form-field col-span-2">
                <label class="field-label">显示内容</label>
                <div class="field-radio-group">
                  <label class="radio-card">
                    <input type="radio" name="hero.title.mode" value="jinrishici" checked class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">今日诗词</span>
                      <span class="radio-desc">自动加载每日诗词</span>
                    </span>
                  </label>
                  <label class="radio-card radio-card-with-input">
                    <input type="radio" name="hero.title.mode" value="text" class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">自定义文字</span>
                      <span class="radio-desc">手动输入标题内容</span>
                      <input type="text" name="hero.title.content" value="Starread" class="radio-inline-input" placeholder="请输入标题内容" />
                    </span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="form-card">
            <h4 class="card-subtitle">文字效果</h4>
            <div class="form-grid">
              <div class="form-field">
                <label class="field-label">渐变样式</label>
                <label class="switch-card">
                  <input type="checkbox" name="hero.effect.gradient.enabled" checked class="switch-input" />
                  <span class="switch-slider"></span>
                  <span class="switch-label">
                    <span class="switch-title">启用渐变效果</span>
                    <span class="switch-desc">标题显示动态渐变颜色</span>
                  </span>
                </label>
              </div>

              <div class="form-field col-span-2">
                <label class="field-label">自定义配色</label>
                <div class="flex gap-2">
                  <input type="color" name="hero.effect.gradient.colors[0]" value="#2563eb" class="w-12 h-10 rounded cursor-pointer border-0" />
                  <input type="color" name="hero.effect.gradient.colors[1]" value="#9333ea" class="w-12 h-10 rounded cursor-pointer border-0" />
                  <input type="color" name="hero.effect.gradient.colors[2]" value="#ec4899" class="w-12 h-10 rounded cursor-pointer border-0" />
                </div>
                <span class="field-hint">从左到右的渐变色，支持3种颜色自定义</span>
              </div>

              <div class="form-field">
                <label class="field-label">打字效果</label>
                <label class="switch-card">
                  <input type="checkbox" name="hero.effect.typing.enabled" checked class="switch-input" />
                  <span class="switch-slider"></span>
                  <span class="switch-label">
                    <span class="switch-title">启用打字动画</span>
                    <span class="switch-desc">文字逐字显示的动画效果</span>
                  </span>
                </label>
              </div>

              <div class="form-field">
                <label class="field-label">动画重复</label>
                <label class="switch-card">
                  <input type="checkbox" name="hero.effect.typing.repeat" class="switch-input" />
                  <span class="switch-slider"></span>
                  <span class="switch-label">
                    <span class="switch-title">启用重复播放</span>
                    <span class="switch-desc">打字完成后自动重新播放</span>
                  </span>
                </label>
              </div>

              <div class="form-field">
                <label class="field-label">粒子华丽效果</label>
                <label class="switch-card">
                  <input type="checkbox" name="hero.effect.particles.enabled" checked class="switch-input" />
                  <span class="switch-slider"></span>
                  <span class="switch-label">
                    <span class="switch-title">启用粒子特效</span>
                    <span class="switch-desc">打字时有彩色粒子飞散效果</span>
                  </span>
                </label>
              </div>

              <div class="form-field">
                <label class="field-label">光标闪烁</label>
                <label class="switch-card">
                  <input type="checkbox" name="hero.effect.typing.cursor" checked class="switch-input" />
                  <span class="switch-slider"></span>
                  <span class="switch-label">
                    <span class="switch-title">启用光标</span>
                    <span class="switch-desc">显示输入|反复闪烁效果</span>
                  </span>
                </label>
              </div>

              <div class="form-field">
                <label class="field-label">光标样式</label>
                <div class="field-radio-group">
                  <label class="radio-card">
                    <input type="radio" name="hero.effect.typing.cursorStyle" value="line" checked class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">竖线 |</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="hero.effect.typing.cursorStyle" value="block" class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">方块 █</span>
                    </span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="site" class="form-section">
          <div class="section-header">
            <span class="section-badge">02</span>
            <div>
              <h3 class="section-title">网站信息</h3>
              <p class="section-subtitle">配置网站的基本信息和品牌标识</p>
            </div>
          </div>

          <div class="form-card">
            <div class="form-grid">
              <div class="form-field">
                <label class="field-label">
                  网站标题
                  <span class="field-required">*</span>
                </label>
                <input type="text" name="site.title" value="星阅主题" class="field-input" placeholder="请输入网站标题" />
                <span class="field-hint">显示在浏览器标签和首页</span>
              </div>

              <div class="form-field">
                <label class="field-label">网站图标</label>
                <input type="text" name="site.favicon" value="/favicon.png" class="field-input" placeholder="/favicon.png" />
                <span class="field-hint">请手动将文件放置在 public/ 目录，然后在此处填写路径</span>
              </div>

              <div class="form-field">
                <label class="field-label">默认封面</label>
                <input type="text" name="site.defaultCover" value="/defaultCover.jpg" class="field-input" placeholder="/defaultCover.jpg" />
                <span class="field-hint">用于没有设置封面的文章，请手动将文件放置在 public/ 目录</span>
              </div>

              <div class="form-field">
                <label class="field-label">建站日期</label>
                <input type="date" name="site.foundedDate" value="2025-10-01" class="field-input" />
                <span class="field-hint">用于计算建站天数</span>
              </div>
            </div>
          </div>

          <div class="form-card">
            <h4 class="card-subtitle">Logo 配置</h4>
            <div class="form-grid">
              <div class="form-field">
                <label class="field-label">Logo 图片</label>
                <div class="field-input-group">
                  <input type="text" name="site.logo.image" value="/logo.svg" class="field-input" placeholder="/logo.svg" readonly />
                  <button class="input-action" type="button" data-upload="logo">
                    <Upload class="w-4 h-4" />
                  </button>
                  <button class="input-action input-action-danger" type="button" data-clear="logo" title="清除文件" style="display: none;">
                    <Trash2 class="w-4 h-4" />
                  </button>
                </div>
              </div>

              <div class="form-field">
                <label class="field-label">暗色模式 Logo</label>
                <div class="field-input-group">
                  <input type="text" name="site.logo.darkImage" value="/logo-dark.svg" class="field-input" placeholder="/logo-dark.svg" readonly />
                  <button class="input-action" type="button" data-upload="darkLogo">
                    <Upload class="w-4 h-4" />
                  </button>
                  <button class="input-action input-action-danger" type="button" data-clear="darkLogo" title="清除文件" style="display: none;">
                    <Trash2 class="w-4 h-4" />
                  </button>
                </div>
              </div>

              <div class="form-field">
                <label class="field-label">Logo 文字</label>
                <input type="text" name="site.logo.text" value="星阅主题" class="field-input" placeholder="星阅主题" />
              </div>

              <div class="form-field">
                <label class="field-label">Alt 文本</label>
                <input type="text" name="site.logo.alt" value="星阅主题 Logo" class="field-input" placeholder="Logo 描述" />
              </div>
            </div>
          </div>

          <div class="form-card">
            <h4 class="card-subtitle">页脚配置</h4>
            <div class="form-field">
              <label class="field-label">版权信息</label>
              <input type="text" name="site.footer.text" value="© 2025 风雅中华 - 阳光明媚，微笑前行" class="field-input" placeholder="© 2025 版权所有" />
            </div>
          </div>
        </section>

        <!-- 文章设置 -->
        <section id="article" class="form-section">
          <div class="section-header">
            <span class="section-badge">03</span>
            <div>
              <h3 class="section-title">文章设置</h3>
              <p class="section-subtitle">配置最新文章组件的展示方式</p>
            </div>
          </div>

          <div class="form-card">
            <div class="form-grid">
              <div class="form-field">
                <label class="field-label">加载类型</label>
                <div class="field-radio-group">
                  <label class="radio-card">
                    <input type="radio" name="site.LatestArticle.type" value="button" checked class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">按钮加载</span>
                      <span class="radio-desc">点击按钮加载更多文章</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="site.LatestArticle.type" value="auto" class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">自动加载</span>
                      <span class="radio-desc">滚动时自动加载</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="form-field">
                <label class="field-label">布局类型</label>
                <div class="field-radio-group">
                  <label class="radio-card">
                    <input type="radio" name="site.LatestArticle.layout" value="vertical" checked class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">垂直布局</span>
                      <span class="radio-desc">纵向排列文章</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="site.LatestArticle.layout" value="horizontal" class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">水平布局</span>
                      <span class="radio-desc">横向排列文章</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="form-field">
                <label class="field-label">默认最大加载数量</label>
                <input type="number" name="site.LatestArticle.defaultLimit" value="20" class="field-input" min="1" max="100" />
              </div>

              <div class="form-field">
                <label class="field-label">初始加载数量</label>
                <input type="number" name="site.LatestArticle.initialLoad" value="4" class="field-input" min="1" max="20" />
              </div>

              <div class="form-field">
                <label class="field-label">每次加载数量</label>
                <input type="number" name="site.LatestArticle.loadMore" value="4" class="field-input" min="1" max="20" />
              </div>

              <div class="form-field">
                <label class="field-label">分栏数</label>
                <input type="number" name="site.LatestArticle.columns" value="2" class="field-input" min="1" max="4" />
              </div>

              <div class="form-field">
                <label class="field-label">默认宽高比</label>
                <select name="site.LatestArticle.defaultAspectRatio" class="field-select">
                  <option value="16:9" selected>16:9 宽屏</option>
                  <option value="4:3">4:3 标准</option>
                  <option value="3:2">3:2 照片</option>
                </select>
              </div>

              <div class="form-field">
                <label class="field-label">横版封面高度</label>
                <input type="text" name="site.LatestArticle.horizontalHeight" value="160px" class="field-input" placeholder="160px" />
              </div>
            </div>
          </div>
        </section>

        <!-- 外观效果 -->
        <section id="appearance" class="form-section">
          <div class="section-header">
            <span class="section-badge">04</span>
            <div>
              <h3 class="section-title">外观效果</h3>
              <p class="section-subtitle">配置语言和动态效果</p>
            </div>
          </div>

          <div class="form-card">
            <div class="form-grid">
              <div class="form-field">
                <label class="field-label">语言设置</label>
                <select name="language" class="field-select">
                  <option value="zh" selected>中文（周一为周起始日）</option>
                  <option value="en">English（周日为周起始日）</option>
                </select>
              </div>

              <div class="form-field">
                <label class="field-label">动态效果</label>
                <label class="switch-card">
                  <input type="checkbox" name="dynamicEffect.postTopWave" checked class="switch-input" />
                  <span class="switch-slider"></span>
                  <span class="switch-label">
                    <span class="switch-title">文章顶部波浪效果</span>
                    <span class="switch-desc">在文章页面顶部显示波浪动画</span>
                  </span>
                </label>
              </div>
            </div>
          </div>
        </section>

        <!-- Banner 配置 -->
        <section id="banner" class="form-section">
          <div class="section-header">
            <span class="section-badge">05</span>
            <div>
              <h3 class="section-title">Banner 配置</h3>
              <p class="section-subtitle">配置首页顶部横幅区域</p>
            </div>
          </div>

          <div class="form-card">
            <div class="form-field">
              <label class="field-label">Banner 标题</label>
              <input type="text" name="widget.banner.title" value="Star read 星阅主题" class="field-input" placeholder="输入 Banner 标题" />
            </div>

            <div class="form-field">
              <label class="field-label">背景图片</label>
              <div class="field-input-group">
                <input type="text" name="widget.banner.backgroundImage" value="https://picsum.photos/1200/300" class="field-input" placeholder="图片 URL" readonly />
                <button class="input-action" type="button" data-upload="bannerBg">
                  <Upload class="w-4 h-4" />
                </button>
                <button class="input-action input-action-danger" type="button" data-clear="bannerBg" title="清除文件" style="display: none;">
                  <Trash2 class="w-4 h-4" />
                </button>
              </div>
            </div>

            <div class="form-field">
              <label class="field-label">标签列表</label>
              <div class="tag-input-container" id="banner-tags">
                <div class="tag-item">
                  <span class="tag-text">基于Vite+Tailwindcss</span>
                  <button class="tag-remove" type="button">
                    <X class="w-3 h-3" />
                  </button>
                </div>
                <div class="tag-item">
                  <span class="tag-text">支持深色模式</span>
                  <button class="tag-remove" type="button">
                    <X class="w-3 h-3" />
                  </button>
                </div>
                <div class="tag-item">
                  <span class="tag-text">模块化组件</span>
                  <button class="tag-remove" type="button">
                    <X class="w-3 h-3" />
                  </button>
                </div>
                <input type="text" class="tag-input" placeholder="输入标签后按回车" />
              </div>
              <textarea name="widget.banner.tags" class="hidden">基于Vite+Tailwindcss
支持深色模式
模块化组件</textarea>
            </div>
          </div>
        </section>

        <!-- 轮播图配置 -->
        <section id="carousel" class="form-section">
          <div class="section-header">
            <span class="section-badge">06</span>
            <div>
              <h3 class="section-title">轮播图配置</h3>
              <p class="section-subtitle">配置首页文章轮播展示</p>
            </div>
          </div>

          <div class="form-card">
            <div class="form-grid">
              <div class="form-field">
                <label class="field-label">轮播标题</label>
                <input type="text" name="widget.carousel.title" value="轮播" class="field-input" />
              </div>

              <div class="form-field">
                <label class="field-label">布局方向</label>
                <div class="field-radio-group">
                  <label class="radio-card">
                    <input type="radio" name="widget.carousel.layout" value="vertical" checked class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">垂直布局</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="widget.carousel.layout" value="horizontal" class="radio-input" />
                    <span class="radio-label">
                      <span class="radio-title">水平布局</span>
                    </span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 作者信息 -->
        <section id="author" class="form-section">
          <div class="section-header">
            <span class="section-badge">07</span>
            <div>
              <h3 class="section-title">作者信息</h3>
              <p class="section-subtitle">配置侧边栏作者卡片</p>
            </div>
          </div>

          <div class="form-card">
            <div class="form-grid">
              <div class="form-field">
