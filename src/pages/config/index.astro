  // 生成配置
  function generateConfig() {
    const config = collectConfigData();
    let configCode = `/**
 * Starread Theme Configuration
 * 
 * 星阅主题配置文件
 * 
 */
import type { StarreadThemeConfig } from './scripts/type/config';

export const themeConfig: StarreadThemeConfig = ${JSON.stringify(config, null, 2)};`;

    configCode = configCode.replace(/"([^"]+)":/g, '$1:');

    const output = document.getElementById('config-output');
    if (output) {
      output.textContent = configCode;
    }
    return configCode;
  }

  function collectConfigData() {
    const formData = new FormData();
    document.querySelectorAll('input[name], select[name], textarea[name]').forEach(el => {
      if (el.type === 'checkbox') {
        formData.append(el.name, el.checked);
      } else {
        formData.append(el.name, el.value);
      }
    });

    const navbarItems = Array.from(document.querySelectorAll('#nav-table-body .nav-row')).map(row => {
      const icon = row.querySelector('[data-field="icon"]')?.value || 'Home';
      const name = row.querySelector('[data-field="name"]')?.value;
      const href = row.querySelector('[data-field="href"]')?.value;
      const indent = parseInt(row.querySelector('[data-field="indent"]')?.value || '0');
      if (href) {
        return { icon, name, href, indent };
      }
      return { icon, name, indent };
    }).filter(item => item.name);

    const i18nLanguages = Array.from(document.querySelectorAll('#i18n-lang-list .i18n-item')).map(item => ({
      code: item.querySelector('[data-field="code"]')?.value,
      name: item.querySelector('[data-field="name"]')?.value,
      flag: item.querySelector('[data-field="flag"]')?.value,
      folder: item.querySelector('[data-field="folder"]')?.value,
    })).filter(l => l.code && l.name);

    const categories = Array.from(document.querySelectorAll('#categories-list .category-item')).map(item => ({
      name: item.querySelector('[data-field="name"]')?.value,
      title: item.querySelector('[data-field="title"]')?.value,
    })).filter(c => c.name && c.title);

    const sidebarHome = collectSidebarConfig('sidebar-home');
    const sidebarArticle = collectSidebarConfig('sidebar-article');

    const locales = {};
    const themeLocales = {};
    i18nLanguages.forEach(lang => {
      const prefix = lang.code === 'zh' ? '/' : `/${lang.code}/`;
      locales[prefix] = {
        lang: lang.code === 'zh' ? 'zh-CN' : `${lang.code}-${lang.code.toUpperCase()}`,
        title: lang.code === 'zh' ? '星阅主题' : 'StarRead Theme',
        description: lang.code === 'zh' ? '基于 Astro 的现代化博客主题' : 'Modern blog theme based on Astro',
        footer: {
          text: lang.code === 'zh' ? '© 2025 风雅中华 - 阳光明媚，微笑前行' : `© 2025 StarRead - Keep smiling and moving forward`,
        },
      };
      themeLocales[prefix] = {
        selectLanguageName: lang.name,
        flag: lang.flag,
        widget: {
          author: {
            name: lang.code === 'zh' ? '风雅中华' : 'StarRead',
            description: lang.code === 'zh' ? '阳光明媚，微笑前行' : 'Keep smiling and moving forward',
          },
          ad: {
            title: lang.code === 'zh' ? '黑曜石博客' : 'Obsidian Blog',
            description: lang.code === 'zh' ? '支持评论弹幕、粒子动画效果、分类' : 'Supports comments, particle effects, categories',
            buttonText: lang.code === 'zh' ? '了解详情' : 'Learn More',
          },
          categories: categories.map(c => ({ name: c.name, title: c.title })),
          carousel: {
            title: lang.code === 'zh' ? '轮播' : 'Carousel',
          },
          banner: {
            title: lang.code === 'zh' ? 'Star read 星阅主题' : 'StarRead Theme',
            tags: ['基于Vite+Tailwindcss', '支持深色模式', '模块化组件'],
          },
        },
        navbar: navbarItems.map(item => ({
          ...item,
          href: item.href ? (item.href.startsWith('/') ? item.href : prefix + item.href) : undefined,
        })),
        sidebar: {
          progress: lang.code === 'zh' ? '字数统计' : 'Word Count',
          author: lang.code === 'zh' ? '作者' : 'Author',
          ad: lang.code === 'zh' ? '广告' : 'Advertisement',
          tagcloud: lang.code === 'zh' ? '标签云' : 'Tag Cloud',
          statistic: lang.code === 'zh' ? '站点统计' : 'Statistics',
          toc: lang.code === 'zh' ? '文章目录' : 'Table of Contents',
        },
        search: {
          placeholder: lang.code === 'zh' ? '搜索文档 (⌘K)' : 'Search docs (⌘K)',
          noResults: lang.code === 'zh' ? '没有找到与 "{query}" 相关的内容，请尝试其他关键词' : 'No results found for "{query}", try other keywords',
          loading: lang.code === 'zh' ? '正在搜索...' : 'Searching...',
          initialTip: lang.code === 'zh' ? '支持使用键盘进行导航，Windows用户请用Ctrl 替换 ⌘' : 'Keyboard navigation supported. Windows users use Ctrl instead of ⌘',
          clear: lang.code === 'zh' ? '清除搜索' : 'Clear Search',
          viewDetails: lang.code === 'zh' ? '查看详情' : 'View Details',
          shortcuts: {
            open: lang.code === 'zh' ? '打开搜索' : 'Open Search',
            browse: lang.code === 'zh' ? '浏览' : 'Browse',
            select: lang.code === 'zh' ? '选择' : 'Select',
            close: lang.code === 'zh' ? '关闭' : 'Close',
          },
        },
      };
    });

    return {
      lang: formData.get('i18n.defaultLang') || 'zh',
      favicon: formData.get('site.favicon'),
      defaultCover: formData.get('site.defaultCover'),
      foundedDate: formData.get('site.foundedDate'),
      loginUrl: formData.get('site.loginUrl') || '/config',
      logo: {
        image: formData.get('site.logo.image'),
        darkImage: formData.get('site.logo.darkImage'),
        text: formData.get('site.logo.text'),
        alt: formData.get('site.logo.alt'),
      },
      hero: {
        enabled: formData.get('hero.enabled') === 'true',
        backgroundImage: formData.get('hero.backgroundImage'),
        title: {
          mode: formData.get('hero.title.mode'),
          content: formData.get('hero.title.content'),
        },
        effect: {
          gradient: {
            enabled: formData.get('hero.effect.gradient.enabled') === 'true',
            colors: [
              formData.get('hero.effect.gradient.colors[0]'),
              formData.get('hero.effect.gradient.colors[1]'),
              formData.get('hero.effect.gradient.colors[2]'),
            ].filter(Boolean),
          },
          typing: {
            enabled: formData.get('hero.effect.typing.enabled') === 'true',
            repeat: formData.get('hero.effect.typing.repeat') === 'true',
            cursor: formData.get('hero.effect.typing.cursor') === 'true',
            cursorStyle: formData.get('hero.effect.typing.cursorStyle'),
          },
          particles: {
            enabled: formData.get('hero.effect.particles.enabled') === 'true',
          },
        },
      },
      navbar: navbarItems,
      sidebar: {
        home: sidebarHome,
        article: sidebarArticle,
      },
      widget: {
        LatestArticle: {
          type: formData.get('site.LatestArticle.type'),
          layout: formData.get('site.LatestArticle.layout'),
          defaultLimit: parseInt(formData.get('site.LatestArticle.defaultLimit')),
          initialLoad: parseInt(formData.get('site.LatestArticle.initialLoad')),
          loadMore: parseInt(formData.get('site.LatestArticle.loadMore')),
          columns: parseInt(formData.get('site.LatestArticle.columns')),
          defaultAspectRatio: formData.get('site.LatestArticle.defaultAspectRatio'),
          horizontalHeight: formData.get('site.LatestArticle.horizontalHeight'),
        },
        author: {
          name: formData.get('widget.author.name'),
          description: formData.get('widget.author.description'),
          avatar: formData.get('widget.author.avatar'),
          social: {},
        },
        ad: {
          title: formData.get('widget.ad.title'),
          description: formData.get('widget.ad.description'),
          buttonText: formData.get('widget.ad.buttonText'),
          link: formData.get('widget.ad.link'),
        },
        categories: categories,
        carousel: {
          title: formData.get('widget.carousel.title'),
          layout: formData.get('widget.carousel.layout'),
        },
        banner: {
          title: formData.get('widget.banner.title'),
          backgroundImage: formData.get('widget.banner.backgroundImage'),
          tags: formData.get('widget.banner.tags')?.split('\n').filter(t => t.trim()) || [],
        },
      },
      dynamicEffect: {
        postTopWave: formData.get('dynamicEffect.postTopWave') === 'true',
      },
      locales: locales,
      themeLocales: themeLocales,
    };
  }

  function collectSidebarConfig(containerId) {
    const container = document.getElementById(containerId);
    const result = {};
    if (!container) return result;

    container.querySelectorAll('.widget-item').forEach(item => {
      const key = item.dataset.key;
      const toggle = item.querySelector('.widget-toggle');
      if (key && toggle) {
        result[key] = toggle.checked;
      }
    });
    return result;
  }

  function downloadConfig() {
    const code = generateConfig();
    const blob = new Blob([code], { type: 'text/typescript' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'starread.config.ts';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function copyConfig() {
    const code = document.getElementById('config-output')?.textContent;
    if (!code) return;

    navigator.clipboard.writeText(code).then(() => {
      const btn = document.getElementById('btn-copy');
      if (btn) {
        const originalText = btn.innerHTML;
        btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mr-1"><path d="M20 6 9 17l-5-5"/></svg>已复制';
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 2000);
      }
    });
  }

  function resetConfig() {
    if (confirm('确定要重置所有配置吗？这将恢复默认值。')) {
      location.reload();
    }
  }
</script>

