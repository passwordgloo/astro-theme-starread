---
import { getCollection } from 'astro:content';
import TagLayout from '../../layouts/tag.astro';

export const prerender = true;

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  
  const allTags = new Set<string>();
  docs.forEach(doc => {
    doc.data.tags?.forEach(tag => allTags.add(tag));
  });
  
  return Array.from(allTags).map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const docsWithTag = await getCollection('docs', ({ data }) =>
  data.tags?.includes(tag) ?? false
);

const allContent = [...docsWithTag].sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const allDocs = await getCollection('docs');
const tagCounts: Record<string, number> = {};
allDocs.forEach(doc => {
  doc.data.tags?.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const pageTitle = `标签: ${tag}`;
---

<TagLayout 
  title={pageTitle} 
  tagName={tag} 
  currentTag={tag} 
  articles={allContent} 
  allTags={tagCounts} 
/>
