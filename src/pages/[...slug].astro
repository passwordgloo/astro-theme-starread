---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/article.astro';
import ArticleNav from '../components/ArticleNav.astro';
import {
  formatDate,
  getCoverImage,
  countWords
} from '../components/frontmatter.ts';

export const prerender = true;

export async function getStaticPaths() {
  const supportedLangs = ['zh', 'en', 'ja', 'ko', 'ru'];
  const defaultLang = 'zh';
  
  const docs = await getCollection('docs', ({ data }) => {
    return data.published !== false;
  });
  
  const reservedRoutes = ['search', 'category', 'tag', 'notes', 'articles', 'zh', 'en', 'ja', 'ko', 'ru', 'config'];
  
  const isValidPath = (path) => {
    if (!path || typeof path !== 'string') {
      return false;
    }
    const trimmed = path.replace(/^\/|\/$/g, '');
    if (!trimmed || trimmed.length === 0) {
      return false;
    }
    if (trimmed.includes('undefined') || trimmed.includes('null')) {
      return false;
    }
    return true;
  };

  function parseEntryId(entryId) {
    const parts = entryId.split('/');
    if (supportedLangs.includes(parts[0])) {
      return {
        lang: parts[0],
        topic: parts.slice(1).join('/'),
        id: entryId
      };
    }
    return {
      lang: defaultLang,
      topic: entryId,
      id: entryId
    };
  }

  const paths = [];

  const sortedEntries = [...docs].sort((a, b) =>
    new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime()
  );

  sortedEntries.forEach((entry, index) => {
    const { lang, topic, id } = parseEntryId(entry.id);
    
    let slug;
    if (lang === defaultLang) {
      slug = topic;
    } else {
      slug = `${lang}/${topic}`;
    }

    if (isValidPath(slug)) {
      paths.push({
        params: { slug },
        props: {
          entry,
          lang,
          topic,
          prev: index < sortedEntries.length - 1 ? sortedEntries[index + 1] : null,
          next: index > 0 ? sortedEntries[index - 1] : null,
        },
      });
    }
  });
  
  return paths;
}

const { entry, prev, next, lang, topic } = Astro.props;
const { slug } = Astro.params;

// 渲染内容
const rendered = await render(entry);
const wordCount = countWords(rendered.code);
const { Content } = rendered;

// 相邻文章信息
const adjacentArticles = {
  prev: prev ? {
    id: prev.id,
    title: prev.data.title,
    cover: getCoverImage(prev.data.cover),
    date: formatDate(prev.data.date),
    collection: prev.id.split('/')[0] || ''
  } : null,
  next: next ? {
    id: next.id,
    title: next.data.title,
    cover: getCoverImage(next.data.cover),
    date: formatDate(next.data.date),
    collection: next.id.split('/')[0] || ''
  } : null
};
---

<BaseLayout 
  title={entry.data.title}
  entry={entry}
  wordCount={wordCount}
  formatDate={formatDate}
  date={formatDate(entry.data.date)}
  tags={entry.data.tags || []}
  categories={entry.data.categories || []}
  cover={getCoverImage(entry.data.cover)}
  permalink={`/${entry.id}`}
>

  <article id="article-content" class="prose max-w-none dark:prose-invert p-4 rounded-lg shadow-sm bg-white/70 backdrop-blur-xl border border-white/20 shadow-[0_1px_0_0_rgba(255,255,255,0.6)_inset,0_8px_30px_rgba(0,0,0,0.06)] dark:bg-cyan-950/30 dark:backdrop-blur-xl dark:border-white/10 dark:shadow-[0_1px_0_0_rgba(255,255,255,0.08)_inset,0_8px_30px_rgba(0,0,0,0.35)]">
    <Content />
  </article>

  <div class="mb-6">
    <ArticleNav 
      prev={adjacentArticles.prev}
      next={adjacentArticles.next}
      lang={lang}
      basePath={`/${topic}`}
    />
  </div>

</BaseLayout>
